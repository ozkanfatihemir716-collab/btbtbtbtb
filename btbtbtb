local AllToggles = {}

local function CreateToggle(parent, text, iconType, callback, defaultState)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(20, 30, 24)
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    local st = Instance.new("UIStroke", btn)
    st.Thickness = 1
    st.Color = Color3.fromRGB(40, 60, 45)
    st.Transparency = 0.5

    createIcon(btn, iconType)

    local tx = Instance.new("TextLabel", btn)
    tx.Size = UDim2.new(1, -90, 1, 0)
    tx.Position = UDim2.new(0, 36, 0, 0)
    tx.BackgroundTransparency = 1
    tx.Text = text
    tx.TextColor3 = Color3.fromRGB(200, 225, 210)
    tx.Font = Enum.Font.GothamBold
    tx.TextSize = 11
    tx.TextXAlignment = Enum.TextXAlignment.Left
    tx.Active = false

    local sw = Instance.new("Frame", btn)
    sw.Size = UDim2.new(0, 34, 0, 17)
    sw.Position = UDim2.new(1, -42, 0.5, -8.5)
    sw.BackgroundColor3 = Color3.fromRGB(40, 60, 45)
    sw.BorderSizePixel = 0
    sw.Active = false
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local kn = Instance.new("Frame", sw)
    kn.Size = UDim2.new(0, 12, 0, 12)
    kn.Position = UDim2.new(0, 3, 0.5, -6)
    kn.BackgroundColor3 = Color3.fromRGB(180, 200, 185)
    kn.BorderSizePixel = 0
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)

    local state = defaultState or false
    local function upd()
        if state then
            btn.BackgroundColor3 = Color3.fromRGB(28, 45, 32)
            st.Color = Settings.C1
            tx.TextColor3 = Color3.fromRGB(255, 255, 255)
            sw.BackgroundColor3 = Settings.C1
            kn.Position = UDim2.new(1, -15, 0.5, -6)
            kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(20, 30, 24)
            st.Color = Color3.fromRGB(40, 60, 45)
            tx.TextColor3 = Color3.fromRGB(200, 225, 210)
            sw.BackgroundColor3 = Color3.fromRGB(40, 60, 45)
            kn.Position = UDim2.new(0, 3, 0.5, -6)
            kn.BackgroundColor3 = Color3.fromRGB(180, 200, 185)
        end
    end
    btn.Activated:Connect(function()
        state = not state
        upd()
        if callback then callback(state) end
    end)
    upd()
    table.insert(AllToggles, {btn = btn, stroke = st, updateV = upd})
    return btn
end

-- 🔧 TAMAMEN YENİDEN YAZILAN SLIDER — sabit ölçüler, düzgün çalışıyor
local function createSlider(parent, label, minV, maxV, currentVal, callback, suffix)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundColor3 = Color3.fromRGB(20, 30, 24)
    row.BorderSizePixel = 0
    row.Active = false
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local sfx = suffix or ""

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -20, 0, 14)
    lbl.Position = UDim2.new(0, 10, 0, 3)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. (math.floor(currentVal * 10) / 10) .. sfx
    lbl.TextColor3 = Color3.fromRGB(200, 225, 210)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Active = false

    local track = Instance.new("TextButton", row)
    track.Size = UDim2.new(1, -20, 0, 20)
    track.Position = UDim2.new(0, 10, 0, 20)
    track.BackgroundColor3 = Color3.fromRGB(30, 42, 34)
    track.Text = ""
    track.BorderSizePixel = 0
    track.AutoButtonColor = false
    track.Active = true
    track.Selectable = true
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((currentVal - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Settings.C1
    fill.BorderSizePixel = 0
    fill.Active = false
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("Frame", fill)
    handle.Size = UDim2.new(0, 14, 0, 14)
    handle.Position = UDim2.new(1, -7, 0.5, -7)
    handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    handle.BorderSizePixel = 0
    handle.Active = false
    handle.ZIndex = 5
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)

    local function setV(v)
        v = math.clamp(v, minV, maxV)
        currentVal = v
        local ratio = (v - minV) / (maxV - minV)
        lbl.Text = label .. ": " .. (math.floor(v * 10) / 10) .. sfx
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        if callback then callback(v) end
    end

    local draggingSlider = false
    local function updateFromInput(input)
        local absPos = track.AbsolutePosition
        local absSize = track.AbsoluteSize
        local x = input.Position.X - absPos.X
        local ratio = math.clamp(x / absSize.X, 0, 1)
        setV(minV + (maxV - minV) * ratio)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            updateFromInput(input)
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingSlider = false
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingSlider then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end)

    -- 🔧 Tema değişince fill rengi güncellensin
    table.insert(IconRecolors, function(color)
        if fill and fill.Parent then fill.BackgroundColor3 = color end
    end)

    return {setV = setV}
end

