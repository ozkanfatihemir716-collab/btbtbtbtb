-- ==================== SIDE DASH ====================
local function startSideDash(target)
    if sideDashActive then return end
    if not target or not target.Character then return end
    local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    sideDashActive = true
    sideDashTimer = 0.5
    sideDashTarget = target
    sideDashUpdateTick = 0

    local behindCF = tHrp.CFrame * CFrame.new(0, 0, 4.5)
    local behindPos = Vector3.new(behindCF.Position.X, tHrp.Position.Y, behindCF.Position.Z)
    local targetCF = CFrame.lookAt(behindPos, tHrp.Position)
    myHrp.CFrame = myHrp.CFrame:Lerp(targetCF, 0.7)

    sideDashCooldown = 5
end

-- ==================== ANA LOOP ====================
RunService.Heartbeat:Connect(function(dt)
    espTick = espTick + dt
    dodgeTick = dodgeTick + dt
    ragdollTick = ragdollTick + dt
    staminaTick = staminaTick + dt
    lagTick = lagTick + dt

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return end

    if G.Speed then
        myHum.WalkSpeed = Settings.WalkSpeed
    else
        myHum.WalkSpeed = 16
    end
    if G.Jump then
        myHum.UseJumpPower = true
        myHum.JumpPower = Settings.JumpPower
    end

    if myHum.Health <= 0 then return end

    local nearest, minDist = nil, 200
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myHrp.Position - root.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = p
                end
            end
        end
    end

    if sideDashActive then
        sideDashTimer = sideDashTimer - dt
        if sideDashTimer <= 0 then
            sideDashActive = false
            sideDashTarget = nil
        else
            local tChar = sideDashTarget and sideDashTarget.Character
            if tChar then
                local tHrp = tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 then
                    sideDashUpdateTick = sideDashUpdateTick + dt
                    if sideDashUpdateTick >= 0.03 then
                        sideDashUpdateTick = 0
                        local offsetZ = 4.5 + math.random() * 0.5
                        local offsetX = (math.random() - 0.5) * 0.5
                        local behindCF = tHrp.CFrame * CFrame.new(offsetX, 0, offsetZ)
                        local behindPos = Vector3.new(behindCF.Position.X, tHrp.Position.Y, behindCF.Position.Z)
                        local targetCF = CFrame.lookAt(behindPos, tHrp.Position)
                        myHrp.CFrame = myHrp.CFrame:Lerp(targetCF, 0.4)
                    end
                else
                    sideDashActive = false
                    sideDashTarget = nil
                end
            else
                sideDashActive = false
                sideDashTarget = nil
            end
        end
    end

    sideDashCooldown = sideDashCooldown - dt
    if G.SideDash and sideDashCooldown <= 0 and not sideDashActive and nearest then
        if minDist >= 4 and minDist <= 7 then
            startSideDash(nearest)
        end
    end

    if G.Dash and not sideDashActive then
        dashCooldown = dashCooldown - dt
        if dashCooldown <= 0 and nearest and minDist < 1.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local frontPos = tHrp.Position + tHrp.CFrame.LookVector * 2
                myHrp.CFrame = CFrame.lookAt(frontPos, tHrp.Position)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                dashCooldown = 0.4
            end
        end
    end

    if dodgeTick >= 1 then
        dodgeTick = 0
        if G.DodgeAttack and not sideDashActive then
            myHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, 0.3)
        end
    end

    if ragdollTick >= 0.1 then
        ragdollTick = 0
        if G.NoRagdoll then
            pcall(function()
                myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end)
            local state = myHum:GetState()
            if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
                pcall(function() myHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
            if myHum.PlatformStand then myHum.PlatformStand = false end
        end
    end

    if staminaTick >= 0.5 then
        staminaTick = 0
        if G.InfStamina then
            for _, name in ipairs({"Stamina", "stamina", "StaminaValue", "Energy", "energy"}) do
                local v = myChar:FindFirstChild(name, true)
                if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                    if v.Value < v.MaxValue then v.Value = v.MaxValue end
                end
            end
        end
    end

    if G.AutoLag and fps < 10 then
        if lagTick >= 4 then
            lagTick = 0
            local candidates = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if tHrp then
                        local dist = (myHrp.Position - tHrp.Position).Magnitude
                        if dist >= 7 and dist <= 10 then
                            table.insert(candidates, p)
                        end
                    end
                end
            end
            if #candidates > 0 then
                lagTarget = candidates[math.random(1, #candidates)]
            else
                lagTarget = nil
            end
        end

        if lagCooldown > 0 then
            lagCooldown = lagCooldown - dt
        end
        if lagCooldown <= 0 and lagTarget then
            local tChar = lagTarget.Character
            if tChar then
                local tHrp = tChar:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local origCF = tHrp.CFrame
                    local shake = Vector3.new(
                        math.random(-2, 2),
                        math.random(-1, 1),
                        math.random(-2, 2)
                    )
                    tHrp.CFrame = origCF * CFrame.new(shake)
                    task.delay(0.05, function()
                        if tHrp and tHrp.Parent then
                            tHrp.CFrame = origCF
                        end
                    end)
                    lagCooldown = 0.5
                end
            else
                lagTarget = nil
            end
        end
    end

    if espTick >= 1 then
        espTick = 0
        if G.ESP then
            for p, d in pairs(espData) do
                if not p.Parent or not d.bb or not d.bb.Parent
                   or not d.character or not d.character.Parent then
                    removeESPForPlayer(p)
                end
            end
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local char = p.Character
                    if char then
                        local head = char:FindFirstChild("Head")
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if head and hum and hum.Health > 0 then
                            local d = espData[p]
                            if not d or d.character ~= char or not d.bb.Parent then
                                createESPForPlayer(p, char, head)
                                d = espData[p]
                            end
                            if d and d.hpLbl and d.hpLbl.Parent then
                                d.hpLbl.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                                d.hpLbl.TextColor3 = getHealthColor(hum)
                            end
                        elseif espData[p] then
                            removeESPForPlayer(p)
                        end
                    elseif espData[p] then
                        removeESPForPlayer(p)
                    end
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    removeESPForPlayer(p)
    if lagTarget == p then lagTarget = nil end
    if sideDashTarget == p then
        sideDashActive = false
        sideDashTarget = nil
    end
end)

