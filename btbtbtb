    espData[p] = { bb = bb, hl = hl, character = char, nameLbl = nameLbl, hpLbl = hpLbl }
end

local perfApplied = false
local perfConnection = nil

local function applyPerformance()
    if perfApplied then return end
    perfApplied = true
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then obj.Enabled = false end
            if obj:IsA("Atmosphere") then obj.Density = 0; obj.Haze = 0; obj.Glare = 0 end
        end
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0; terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0; terrain.WaterTransparency = 1
            terrain.Decoration = false
        end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "TSB_Hitbox" then
                obj.Material = Enum.Material.Plastic
                obj.Reflectance = 0
                obj.CastShadow = false
            end
        end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("MeshPart") then
                obj.RenderFidelity = Enum.RenderFidelity.Performance
                obj.CastShadow = false
            end
        end
        local targets = {"Tree", "Rock", "Stone", "Debris", "Effect", "Grass", "Bush", "Wood", "Leaf"}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                for _, name in ipairs(targets) do
                    if obj.Name:lower():find(name:lower()) then obj:Destroy(); break end
                end
            end
        end
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.FogEnd = 100000; Lighting.FogStart = 0
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        setfpscap(999)
    end)
    perfConnection = workspace.DescendantAdded:Connect(function(obj)
        if not perfApplied then return end
        pcall(function()
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                obj.Enabled = false
            elseif obj:IsA("BasePart") and obj.Name ~= "TSB_Hitbox" then
                obj.Material = Enum.Material.Plastic
                obj.Reflectance = 0
                obj.CastShadow = false
            elseif obj:IsA("MeshPart") then
                obj.RenderFidelity = Enum.RenderFidelity.Performance
                obj.CastShadow = false
            end
        end)
    end)
end

local function removePerformance()
    if not perfApplied then return end
    perfApplied = false
    if perfConnection then perfConnection:Disconnect(); perfConnection = nil end
    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.5
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then obj.Enabled = true end
        end
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level21
        Lighting.FogEnd = 10000; Lighting.FogStart = 100
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
        Lighting.Brightness = 2
    end)
end

