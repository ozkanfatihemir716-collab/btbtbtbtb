-- FIX: Use CameraType.Custom (not Scriptable) + priority > Camera(200)
-- This keeps camera position following player, only overrides look direction
local function aimBind()
    if not G.Aimlock then
        if aimTarget then aimTarget = nil end
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local myChar = LocalPlayer.Character
    if not myChar then aimTarget = nil; return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then
        aimTarget = nil
        return
    end

    -- Ensure camera is Custom so it keeps following player
    if cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
        cam.CameraSubject = myHum
    end

    -- Validate existing target
    if aimTarget then
        local tChar = aimTarget.Character
        if not tChar then
            aimTarget = nil
        else
            local tHrp = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            if not tHrp or not tHum or tHum.Health <= 0 then
                aimTarget = nil
            elseif (myHrp.Position - tHrp.Position).Magnitude > 20 then
                aimTarget = nil
            end
        end
    end

    -- Find new target if none (1m ≈ 3.5 studs, but use 6 for practical lock)
    if not aimTarget then
        local nearest, minDist = nil, 6
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myHrp.Position - root.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = p
                    end
                end
            end
        end
        if nearest then aimTarget = nearest end
    end

    -- Apply camera lock: keep current position (follows player), change direction
    if aimTarget and aimTarget.Character then
        local head = aimTarget.Character:FindFirstChild("Head")
        if head then
            local camPos = cam.CFrame.Position
            cam.CFrame = CFrame.lookAt(camPos, head.Position)
        end
    end
end

-- Priority 2000 = after camera(200), runs last → our CFrame override sticks
local aimBound = pcall(function()
    RunService:BindToRenderStep("NOVE_AIM", 2000, aimBind)
end)

if not aimBound then
    -- Fallback: RenderStepped + Scriptable with manual position from player
    RunService.RenderStepped:Connect(function()
        if not G.Aimlock then
            if aimTarget then aimTarget = nil end
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local myChar = LocalPlayer.Character
        if not myChar then aimTarget = nil; return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        local myHead = myChar:FindFirstChild("Head")
        if not myHrp or not myHum or not myHead or myHum.Health <= 0 then
            aimTarget = nil
            return
        end

        if aimTarget then
            local tChar = aimTarget.Character
            if not tChar then aimTarget = nil
            else
                local tHrp = tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                if not tHrp or not tHum or tHum.Health <= 0 then aimTarget = nil
                elseif (myHrp.Position - tHrp.Position).Magnitude > 20 then aimTarget = nil
                end
            end
        end

        if not aimTarget then
            local nearest, minDist = nil, 6
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local root = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if root and hum and hum.Health > 0 then
                        local dist = (myHrp.Position - root.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = p
                        end
                    end
                end
            end
            if nearest then aimTarget = nearest end
        end

        if aimTarget and aimTarget.Character then
            local head = aimTarget.Character:FindFirstChild("Head")
            if head then
                if cam.CameraType ~= Enum.CameraType.Scriptable then
                    cam.CameraType = Enum.CameraType.Scriptable
                end
                -- Position camera behind player, looking at target
                local camPos = myHead.Position - myHrp.CFrame.LookVector * 8 + Vector3.new(0, 3, 0)
                cam.CFrame = CFrame.lookAt(camPos, head.Position)
            end
        end
    end)
end

-- ==================== SIDE DASH ====================
local function startSideDash(target)
    if not target or not target.Character then return end
    local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local behindCF = tHrp.CFrame * CFrame.new(0, 0, 1)
    local newPos = Vector3.new(behindCF.Position.X, myHrp.Position.Y, behindCF.Position.Z)
    local newCF = CFrame.lookAt(newPos, tHrp.Position)

    local ok = pcall(function() myChar:PivotTo(newCF) end)
    if not ok then
        pcall(function() myHrp.CFrame = newCF end)
    end
    pcall(function()
        myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
end

-- ==================== MAIN LOOP ====================
RunService.Heartbeat:Connect(function(dt)
    espTick = espTick + dt
    dodgeTick = dodgeTick + dt
    ragdollTick = ragdollTick + dt
    staminaTick = staminaTick + dt
    lagTick = lagTick + dt

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return end

    if G.Speed then
        myHum.WalkSpeed = Settings.WalkSpeed
    else
        myHum.WalkSpeed = 16
    end
    if G.Jump then
        myHum.UseJumpPower = true
        myHum.JumpPower = Settings.JumpPower
    end

    if myHum.Health <= 0 then return end

    local nearest, minDist = nil, 200
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myHrp.Position - root.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = p
                end
            end
        end
    end

    sideDashCooldown = sideDashCooldown - dt
    if G.SideDash and sideDashCooldown <= 0 and nearest then
        if minDist >= 3.5 and minDist <= 10 then
            startSideDash(nearest)
            sideDashCooldown = 3
        end
    end

    if G.Dash then
        dashCooldown = dashCooldown - dt
        if dashCooldown <= 0 and nearest and minDist < 1.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local frontPos = tHrp.Position + tHrp.CFrame.LookVector * 2
                myHrp.CFrame = CFrame.lookAt(frontPos, tHrp.Position)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                dashCooldown = 0.4
            end
        end
    end

    if dodgeTick >= 1 then
        dodgeTick = 0
        if G.DodgeAttack then
            myHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, 0.3)
        end
    end

    if ragdollTick >= 0.1 then
        ragdollTick = 0
        if G.NoRagdoll then
            pcall(function()
                myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end)
            local state = myHum:GetState()
            if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
                pcall(function() myHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
            if myHum.PlatformStand then myHum.PlatformStand = false end
        end
    end

    if staminaTick >= 0.5 then
        staminaTick = 0
        if G.InfStamina then
            for _, name in ipairs({"Stamina","stamina","StaminaValue","Energy","energy"}) do
                local v = myChar:FindFirstChild(name, true)
                if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                    if v.Value < v.MaxValue then v.Value = v.MaxValue end
                end
            end
        end
    end

    if G.AutoLag and fps < 10 then
        if lagTick >= 4 then
            lagTick = 0
            local candidates = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if tHrp then
                        local d = (myHrp.Position - tHrp.Position).Magnitude
                        if d >= 7 and d <= 10 then table.insert(candidates, p) end
                    end
                end
            end
            if #candidates > 0 then
                lagTarget = candidates[math.random(1, #candidates)]
            else
                lagTarget = nil
            end
        end

        if lagCooldown > 0 then lagCooldown = lagCooldown - dt end
        if lagCooldown <= 0 and lagTarget then
            local tChar = lagTarget.Character
            if tChar then
                local tHrp = tChar:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local orig = tHrp.CFrame
                    local shake = Vector3.new(math.random(-2,2), math.random(-1,1), math.random(-2,2))
                    tHrp.CFrame = orig * CFrame.new(shake)
                    task.delay(0.05, function()
                        if tHrp and tHrp.Parent then tHrp.CFrame = orig end
                    end)
                    lagCooldown = 0.5
                end
            else
                lagTarget = nil
            end
        end
    end

    if espTick >= 1 then
        espTick = 0
        if G.ESP then
            for p, d in pairs(espData) do
                if not p.Parent or not d.bb or not d.bb.Parent
                or not d.character or not d.character.Parent then
                    removeESPForPlayer(p)
                end
            end
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local char = p.Character
                    if char then
                        local head = char:FindFirstChild("Head")
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if head and hum and hum.Health > 0 then
                            local d = espData[p]
                            if not d or d.character ~= char or not d.bb.Parent then
                                createESPForPlayer(p, char, head)
                                d = espData[p]
                            end
                            if d and d.hpLbl and d.hpLbl.Parent then
                                d.hpLbl.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                                d.hpLbl.TextColor3 = getHealthColor(hum)
                            end
                        elseif espData[p] then
                            removeESPForPlayer(p)
                        end
                    elseif espData[p] then
                        removeESPForPlayer(p)
                    end
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    removeESPForPlayer(p)
    if lagTarget == p then lagTarget = nil end
    if aimTarget == p then aimTarget = nil end
end)

local function setupCharacter(char)
    task.wait(0.5)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        if G.Speed then hum.WalkSpeed = Settings.WalkSpeed end
        if G.Jump then
            hum.UseJumpPower = true
            hum.JumpPower = Settings.JumpPower
        end
        hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if G.Speed and hum.WalkSpeed ~= Settings.WalkSpeed then
                hum.WalkSpeed = Settings.WalkSpeed
            end
        end)
        hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if G.Jump and hum.JumpPower ~= Settings.JumpPower then
                hum.JumpPower = Settings.JumpPower
            end
        end)
    end
    task.wait(0.5)
    if G.Hitbox then
        removeHitbox()
        createHitbox()
    end
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)

