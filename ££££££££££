local function refreshAllLang()
    for _, r in ipairs(LangRefs.plain) do
        if r.obj and r.obj.Parent then r.obj.Text = L(r.key) end
    end
    for _, r in ipairs(LangRefs.sections) do
        if r.obj and r.obj.Parent then r.obj.Text = "── " .. L(r.key) .. " ──" end
    end
    for _, r in ipairs(LangRefs.sliders) do
        if r.lbl and r.lbl.Parent then
            local v = r.getVal()
            r.lbl.Text = L(r.key) .. ": " .. (math.floor(v * 10) / 10) .. (r.suffix or "")
        end
    end
    for _, r in ipairs(LangRefs.buttons) do
        if r.obj and r.obj.Parent then r.obj.Text = L(r.key) end
    end
    if hopBtn and hopBtn.Parent then
        if hopState == "searching" then
            hopBtn.Text = L("searching")
        elseif hopState == nil then
            hopBtn.Text = L("server_switch")
        end
    end
end

